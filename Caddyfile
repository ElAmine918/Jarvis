# Caddyfile — Reverse Proxy
#
# If you have a domain (e.g., jarvis.example.com), replace :80 with your domain
# and Caddy will automatically provision Let's Encrypt HTTPS certificates.

:80 {
    # Route traffic to the Open WebUI container by default
    reverse_proxy open-webui:8080

    # Route /api/ traffic directly to the Jarvis backend
    handle /api/* {
        reverse_proxy jarvis:8080
    }
}
