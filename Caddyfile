# Caddyfile — Reverse Proxy
#
# Par défaut, Caddy répond sur le port 80/443.
# Ajoute tes projets ici au fur et à mesure.
#
# Si tu as un domaine (ex: mycloud.example.com), remplace
# :80 par ton domaine et Caddy gère le HTTPS automatiquement.
#
# Pour l'instant, accès local uniquement via Tailscale IP.

:80 {
    respond "Jarvis is running. Nothing to see here." 200
}

# --- Exemples pour tes projets ---
# Décommente et adapte quand tu déploies un projet
#
# chess.mycloud.example.com {
#     reverse_proxy chess-backend:8000
# }
#
# app.mycloud.example.com {
#     reverse_proxy my-app:3000
# }
