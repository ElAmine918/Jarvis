# ==============================================================================
# JARVIS AI SYSTEM - CONFIGURATION D'ENVIRONNEMENT (.env)
# ==============================================================================

# --- Interface Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# --- Authentification & Sécurité ---
ADMIN_PASSWORD=your_secure_admin_dashboard_password_here
JARVIS_API_KEY=your_secure_internal_api_key_here
WEBUI_SECRET_KEY=your_random_webui_secret_key_here
CORS_ALLOWED_ORIGINS=http://open-webui:8080,http://localhost:3000,http://127.0.0.1:3000

# --- Fournisseurs de Modèles de Langage (LLM) ---
# Tier 1 : Local LM Studio (Mac M4 via réseau local ou Tailscale)
LM_STUDIO_URL=http://100.x.x.x:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
LM_STUDIO_HEALTH_TIMEOUT=2.0

# Tier 2 : OpenRouter (Cloud multi-fournisseurs)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Tier 3 : Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# Groq (Inférence Ultra-Rapide)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI (Optionnel)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Tier 4 : Ollama (Survie Locale Homelab)
OLLAMA_LOCAL_URL=http://ollama:11434/v1
OLLAMA_LOCAL_MODEL=llama3.2:3b

# --- Base de Données Vectorielle (PostgreSQL + pgvector) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret_change_in_prod
POSTGRES_HOST=jarvis-pgvector
POSTGRES_DB=jarvis_memory
DB_PASSWORD=jarvis_secret_change_in_prod

# --- Gestionnaire Proxmox VE ---
PROXMOX_HOST=192.168.2.100
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=jarvis
PROXMOX_TOKEN_VALUE=your_proxmox_api_token_uuid_here

# --- Serveur API Interne & Chemins Système ---
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
SKILLS_DIR=/app/data/skills
MEMORY_DB_PATH=/app/data/memory.db
LOGS_DB_PATH=/app/data/logs.db
WORKSPACE_DIR=/app/workspace

# --- Vocal & Multimodal (STT / TTS) ---
VOICE_TTS_ENABLED=true
LOCAL_STT_URL=http://whisper:9000
LOCAL_TTS_URL=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=nPczCjzI2devNBz1zQrb
VOICE_LIVE_TTS=fr-FR-RemyMultilingualNeural

# --- Dépôt & CI/CD ---
GITHUB_TOKEN=
