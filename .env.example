# ================================================
# MyCloud — Jarvis AI Assistant — Environment Variables
# ================================================
# cp .env.example .env  then fill in the values
#
# This file documents ALL environment variables used by Jarvis.
# Variables marked (required) must be set for core functionality.
# Variables marked (optional) have sensible defaults.

# -----------------------------------------------
# SECURITY (required — Jarvis will start but features are limited)
# -----------------------------------------------

# API Bearer token for /v1/* endpoints
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_KEY=

# Password for the admin web dashboard
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# Secret key for Open WebUI sessions
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=

# -----------------------------------------------
# TELEGRAM (optional — bot disabled if absent)
# -----------------------------------------------
# 1. Talk to @BotFather on Telegram → /newbot
# 2. Copy the token here
TELEGRAM_BOT_TOKEN=

# Your Telegram User ID (comma-separated if multiple)
# Find it by talking to @userinfobot
ALLOWED_TELEGRAM_USER_IDS=

# -----------------------------------------------
# TIER 1 — GEMINI (Cloud Primary)
# -----------------------------------------------
# Free API key from: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day with Gemini Flash
GEMINI_API_KEY=

# Model to use (gemini-2.0-flash is free)
GEMINI_MODEL=gemini-2.0-flash

# Base URL for Gemini API (hardcoded default, override only if needed)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# -----------------------------------------------
# TIER 2 — OPENROUTER (Cloud Fallback)
# -----------------------------------------------
OPENROUTER_API_KEY=

# Model ID on OpenRouter (default is free Qwen 3.8 27B)
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Base URL for OpenRouter API (hardcoded default, override only if needed)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------
# TIER 3 — LM STUDIO (Local Mac via Tailscale)
# -----------------------------------------------
# Tailscale IP of your Mac + LM Studio port (default 1234)
# Example: http://100.64.0.2:1234/v1
LM_STUDIO_URL=http://TAILSCALE_MAC_IP:1234/v1

# Exact model name loaded in LM Studio
# (visible in LM Studio → Local Server → Model)
LM_STUDIO_MODEL=qwen2.5-14b-instruct

# Health check timeout (seconds) — 2s recommended
LM_STUDIO_HEALTH_TIMEOUT=2.0

# -----------------------------------------------
# TIER 4 — OLLAMA (Local Homelab SLM Survival)
# -----------------------------------------------
# URL for Ollama API (Docker service name or IP)
OLLAMA_LOCAL_URL=http://ollama:11434/v1

# Preferred model (auto-fallback: qwen2.5:7b → llama3.2:1b → qwen2.5:1.5b → gemma2:2b)
OLLAMA_LOCAL_MODEL=qwen2.5:7b

# -----------------------------------------------
# VOICE (STT / TTS via Telegram)
# -----------------------------------------------
# OpenAI API key for Whisper transcription (optional — uses Gemini as fallback)
# OPENAI_API_KEY=sk-...

# Enable/disable voice response (edge-tts) — true by default
VOICE_TTS_ENABLED=true

# -----------------------------------------------
# CORS — Allowed origins for the API
# -----------------------------------------------
# Comma-separated. Empty = restricted to Docker internal origins.
# Example for custom domain:
# CORS_ALLOWED_ORIGINS=https://jarvis.your-domain.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------
# API SERVER (for Open WebUI)
# -----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080

# -----------------------------------------------
# PATHS (don't change unless you have a reason)
# -----------------------------------------------
SKILLS_DIR=/app/data/skills
MEMORY_DB_PATH=/app/data/memory.db
WORKSPACE_DIR=/app/workspace

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
LOG_LEVEL=INFO
