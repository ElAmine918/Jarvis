# ================================================
# MyCloud — Jarvis — Variables d'environnement
# ================================================
# cp .env.example .env  puis remplis les valeurs

# -----------------------------------------------
# TELEGRAM (optionnel — bot désactivé si absent)
# -----------------------------------------------
# 1. Parle à @BotFather sur Telegram → /newbot
# 2. Copie le token ici
TELEGRAM_BOT_TOKEN=

# Ton User ID Telegram (séparés par virgule si plusieurs)
# Trouve-le en parlant à @userinfobot
ALLOWED_TELEGRAM_USER_IDS=

# -----------------------------------------------
# LM STUDIO — Modèle local sur ton Mac
# -----------------------------------------------
# Adresse Tailscale de ton Mac + port LM Studio (défaut 1234)
# Exemple : http://100.64.0.2:1234/v1
LM_STUDIO_URL=http://TAILSCALE_MAC_IP:1234/v1

# Nom exact du modèle chargé dans LM Studio
# (visible dans LM Studio → Local Server → Model)
LM_STUDIO_MODEL=qwen2.5-14b-instruct

# Timeout du health check (secondes) — 2s recommandé
LM_STUDIO_HEALTH_TIMEOUT=2.0

# -----------------------------------------------
# GEMINI — Fallback gratuit (quand Mac est éteint)
# -----------------------------------------------
# Clé gratuite sur : https://aistudio.google.com/app/apikey
# Free tier : 1500 requêtes/jour avec Gemini Flash
GEMINI_API_KEY=

# Modèle Gemini à utiliser (gemini-2.0-flash est gratuit)
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------
# SERVEUR API (pour Open WebUI)
# -----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080

# -----------------------------------------------
# CHEMINS (ne pas changer sauf raison valable)
# -----------------------------------------------
SKILLS_DIR=/app/data/skills
MEMORY_DB_PATH=/app/data/memory.db
WORKSPACE_DIR=/app/workspace

# -----------------------------------------------
# LOGGING
# -----------------------------------------------
LOG_LEVEL=INFO
