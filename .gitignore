# ==========================================
# MyCloud — Jarvis AI Agent .gitignore
# ==========================================

# --- OS & IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Secrets & Environment ---
.env
.env.*
!.env.example
# C-03 : Explicitement les .env des sous-dossiers (ne pas se fier uniquement au pattern racine)
jarvis/.env
jarvis/.env.*
*.pem
*.key
*.pfx
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# --- Docker ---
# Ne pas commit les volumes Docker montés localement
data/
workspace/

# --- Jarvis memory & runtime ---
jarvis/data/
*.db
*.db-journal

# --- Logs ---
*.log
logs/

# --- Temp & Deployment artifacts ---
*.tmp
*.tar.gz
tmp/
scratch/
test_*.py
